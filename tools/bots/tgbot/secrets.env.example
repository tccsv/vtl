# Секреты для запуска Telegram-бота VTL.
#
# Скопируй этот файл рядом под именем secrets.env и впиши свои значения:
#     copy tools\bot\secrets.env.example tools\bot\secrets.env
#
# secrets.env НЕ коммитится (он в .gitignore) — токен остаётся только у тебя.
# Формат: KEY=VALUE, без пробелов вокруг '=', строки с # игнорируются.

# Токен бота от @BotFather (обязательно).
TG_BOT_TOKEN=PUT_YOUR_BOT_TOKEN_HERE

# Id чата, куда бот реально постит при /publish (нужен для отправки в Telegram).
# Узнать: написать боту, открыть https://api.telegram.org/tgbot<ТОКЕН>/getUpdates,
# взять message.chat.id из ответа.
TG_CHAT_ID=PUT_YOUR_CHAT_ID_HERE
