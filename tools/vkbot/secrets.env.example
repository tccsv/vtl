# Секреты для запуска VK-бота VTL.
#
# Скопируй рядом под именем secrets.env и впиши свои значения:
#     copy tools\vkbot\secrets.env.example tools\vkbot\secrets.env
#
# secrets.env НЕ коммитится (он в .gitignore).
# Формат: KEY=VALUE, без пробелов вокруг '=', строки с # игнорируются.

# Ключ доступа сообщества (Long Poll API). Настройки сообщества -> Работа с API.
VK_TOKEN=PUT_YOUR_VK_TOKEN_HERE

# Числовой id сообщества (group_id).
VK_GROUP_ID=PUT_YOUR_GROUP_ID_HERE
