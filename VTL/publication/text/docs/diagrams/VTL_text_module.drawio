        <mxCell id="e2_marker_kind" value="kind" style="endArrow=open;endFill=0;endSize=12;startArrow=none;html=1;rounded=0;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;fontSize=10;" edge="1" parent="1" source="p2_marker" target="p2_kind">
