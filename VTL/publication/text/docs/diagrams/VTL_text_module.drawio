        <mxCell id="p2_title" value="&lt;b&gt;Унифицированная архитектура процессора&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;одинаковая для markdown / telegram / html / asciidoc · префикс шаблонный — VTL_&amp;lt;format&amp;gt;_*&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=0" vertex="1" parent="1">
          <mxGeometry x="40" y="0" width="1100" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="p2_note" value="&lt;b&gt;Параллельный режим (Parallel)&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;У каждого сканера — собственный &lt;b&gt;MarkerList&lt;/b&gt;.&lt;br&gt;Локов нет. После thread_join — слияние и сортировка маркеров.&lt;br&gt;&lt;br&gt;Сериализация (Serializer) — всегда один поток: линейная сборка, упирается в memcpy." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;fontSize=11;spacingLeft=6;spacingTop=4;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="1200" y="60" width="320" height="170" as="geometry"/>
        </mxCell>

        <mxCell id="p2_data_lbl" value="Данные сканера (_data.h)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=4" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="600" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="p2_kind" value="&lt;b&gt;MarkerKind&lt;/b&gt;&lt;br&gt;&lt;i&gt;&amp;lt;&amp;lt;enum&amp;gt;&amp;gt;&lt;/i&gt;&lt;hr size=&quot;1&quot;&gt;kBoldStart / kBoldEnd&lt;br&gt;kItalicStart / kItalicEnd&lt;br&gt;kStrikeStart / kStrikeEnd&lt;br&gt;&lt;i&gt;asciidoc-only:&lt;/i&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;kMono / Sub / Sup&lt;br&gt;&amp;nbsp;&amp;nbsp;kHeading, kListItem&lt;br&gt;&amp;nbsp;&amp;nbsp;kCodeBlock / QuotedBlock&lt;br&gt;&amp;nbsp;&amp;nbsp;kComment, kAttribute&lt;br&gt;&amp;nbsp;&amp;nbsp;kAdmonition&lt;br&gt;&amp;nbsp;&amp;nbsp;kLink, kCrossReference" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;fontSize=12;spacingLeft=6;spacingTop=4;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="300" height="280" as="geometry"/>
        </mxCell>

        <mxCell id="p2_marker" value="&lt;b&gt;Marker&lt;/b&gt;&lt;br&gt;&lt;i&gt;&amp;lt;&amp;lt;struct&amp;gt;&amp;gt;&lt;/i&gt;&lt;hr size=&quot;1&quot;&gt;+ kind&amp;nbsp;&amp;nbsp;&amp;nbsp;: MarkerKind&lt;br&gt;+ pos&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; : size_t&lt;br&gt;+ length : size_t&lt;br&gt;+ level&amp;nbsp;&amp;nbsp;: int&amp;nbsp;&amp;nbsp;&lt;i&gt;(только asciidoc)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;fontSize=12;spacingLeft=6;spacingTop=4;spacingRight=6;" vertex="1" parent="1">
