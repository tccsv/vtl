        </mxCell>

        <mxCell id="p2_list" value="&lt;b&gt;MarkerList&lt;/b&gt;&lt;br&gt;&lt;i&gt;&amp;lt;&amp;lt;struct, dynamic array, ×2 grow&amp;gt;&amp;gt;&lt;/i&gt;&lt;hr size=&quot;1&quot;&gt;+ items&amp;nbsp;&amp;nbsp;&amp;nbsp; : Marker*&lt;br&gt;+ length&amp;nbsp;&amp;nbsp; : size_t&lt;br&gt;+ capacity : size_t&lt;hr size=&quot;1&quot;&gt;+ Init(list*)&lt;br&gt;+ Reserve(list*, capacity)&lt;br&gt;+ Push(list*, marker)&lt;br&gt;+ Clear(list*)&lt;br&gt;+ Free(list*)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;fontSize=12;spacingLeft=6;spacingTop=4;spacingRight=6;" vertex="1" parent="1">
