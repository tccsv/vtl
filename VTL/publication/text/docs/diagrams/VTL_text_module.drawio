        <mxCell id="e2_scan_ctx" value="void* ctx" style="endArrow=open;endFill=0;endSize=12;startArrow=none;html=1;rounded=0;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontSize=10;" edge="1" parent="1" source="p2_scan" target="p2_ctx">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e2_parser_scan" value="запускает (Seq:1 поток, Par:N)" style="endArrow=open;endFill=0;endSize=12;startArrow=none;html=1;rounded=0;dashed=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontSize=10;" edge="1" parent="1" source="p2_parser" target="p2_scan">
