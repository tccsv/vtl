        <mxCell id="e2_parser_ctx" value="создаёт N штук" style="endArrow=open;endFill=0;endSize=12;startArrow=none;html=1;rounded=0;dashed=1;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontSize=10;" edge="1" parent="1" source="p2_parser" target="p2_ctx">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e2_parser_list" value="собирает в" style="endArrow=open;endFill=0;endSize=12;startArrow=none;html=1;rounded=0;dashed=1;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=1;entryDx=0;entryDy=0;fontSize=10;" edge="1" parent="1" source="p2_parser" target="p2_list">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e2_parser_conv" value="markers" style="endArrow=open;endFill=0;endSize=12;startArrow=none;html=1;rounded=0;dashed=1;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;fontSize=10;" edge="1" parent="1" source="p2_parser" target="p2_conv">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e2_parser_thr" value="только Parallel" style="endArrow=open;endFill=0;endSize=12;startArrow=none;html=1;rounded=0;dashed=1;exitX=0.6;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;" edge="1" parent="1" source="p2_parser" target="p2_thr">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e2_conv_marker" value="читает" style="endArrow=open;endFill=0;endSize=12;startArrow=none;html=1;rounded=0;dashed=1;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontSize=10;" edge="1" parent="1" source="p2_conv" target="p2_marker">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e2_ser_marker" value="пишет токены обратно" style="endArrow=open;endFill=0;endSize=12;startArrow=none;html=1;rounded=0;dashed=1;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=1;entryDx=0;entryDy=0;fontSize=10;" edge="1" parent="1" source="p2_ser" target="p2_marker">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="dataflow" name="3. Data flow">
    <mxGraphModel dx="1422" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="p3_title" value="&lt;b&gt;Поток данных&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;исходный текст → MarkedText → результат в целевом формате&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=0" vertex="1" parent="1">
          <mxGeometry x="40" y="0" width="1100" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="p3_raw" value="&lt;b&gt;RawText&lt;/b&gt;&lt;br&gt;&lt;i&gt;VTL_publication_Text&lt;/i&gt;&lt;hr size=&quot;1&quot;&gt;Исходный текст с разметкой выбранного формата&lt;br&gt;&lt;br&gt;&lt;i&gt;(может быть прочитан с диска через VTL_publication_text_Read)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;fontSize=12;spacingLeft=6;spacingTop=4;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="320" height="180" as="geometry"/>
        </mxCell>

        <mxCell id="p3_markers" value="&lt;b&gt;Markers&lt;/b&gt;&lt;br&gt;&lt;i&gt;&amp;lt;format&amp;gt;_MarkerList&lt;/i&gt;&lt;hr size=&quot;1&quot;&gt;Список найденных токенов разметки&lt;br&gt;(позиция, длина, kind)&lt;br&gt;&lt;br&gt;&lt;i&gt;Промежуточная структура,&lt;br&gt;живёт до конца Parse*.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=top;fontSize=12;spacingLeft=6;spacingTop=4;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="460" y="240" width="320" height="180" as="geometry"/>
        </mxCell>

        <mxCell id="p3_marked" value="&lt;b&gt;Marked&lt;/b&gt;&lt;br&gt;&lt;i&gt;VTL_publication_MarkedText&lt;/i&gt;&lt;hr size=&quot;1&quot;&gt;Текст, нарезанный на части,&lt;br&gt;каждая со своими битовыми флагами&lt;br&gt;BOLD / ITALIC / STRIKETHROUGH" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;fontSize=12;spacingLeft=6;spacingTop=4;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="880" y="240" width="320" height="180" as="geometry"/>
        </mxCell>

        <mxCell id="p3_out" value="&lt;b&gt;Output&lt;/b&gt;&lt;br&gt;&lt;i&gt;VTL_publication_Text&lt;/i&gt;&lt;hr size=&quot;1&quot;&gt;Результат в целевом формате разметки&lt;br&gt;(может отличаться от исходного формата)&lt;br&gt;&lt;br&gt;&lt;i&gt;(может быть записан на диск через VTL_publication_text_Write)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=left;verticalAlign=top;fontSize=12;spacingLeft=6;spacingTop=4;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="1300" y="240" width="320" height="180" as="geometry"/>
        </mxCell>

        <mxCell id="p3_arrow1" value="&lt;b&gt;Scanners + Parser&lt;/b&gt;&lt;br&gt;Sequential / Parallel" style="endArrow=classic;endFill=1;endSize=12;startArrow=none;html=1;rounded=0;strokeWidth=2;fontSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3_raw" target="p3_markers">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="p3_arrow2" value="&lt;b&gt;Converter&lt;/b&gt;&lt;br&gt;ConvertToMarkedText" style="endArrow=classic;endFill=1;endSize=12;startArrow=none;html=1;rounded=0;strokeWidth=2;fontSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3_markers" target="p3_marked">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="p3_arrow3" value="&lt;b&gt;Serializer&lt;/b&gt;&lt;br&gt;SerializeFromMarkedText" style="endArrow=classic;endFill=1;endSize=12;startArrow=none;html=1;rounded=0;strokeWidth=2;fontSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3_marked" target="p3_out">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="p3_phase1" value="&lt;b&gt;Parse phase&lt;/b&gt;&lt;br&gt;&lt;i&gt;может быть параллельной&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="470" width="540" height="44" as="geometry"/>
        </mxCell>

        <mxCell id="p3_phase2" value="&lt;b&gt;Serialize phase&lt;/b&gt;&lt;br&gt;&lt;i&gt;всегда один поток (memcpy-bound)&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="470" width="720" height="44" as="geometry"/>
        </mxCell>

        <mxCell id="p3_legend" value="&lt;b&gt;Где это происходит&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;b&gt;Init&lt;/b&gt; (фасад VTL_publication_marked_text_Init) запускает &lt;b&gt;Parse phase&lt;/b&gt;:&lt;br&gt;дёргает &lt;i&gt;Parser&lt;/i&gt; нужного формата (внутри — Scanners → MarkerList → Converter).&lt;br&gt;&lt;br&gt;&lt;b&gt;TransformTo&amp;lt;Format&amp;gt;&lt;/b&gt; (фасад) запускает &lt;b&gt;Serialize phase&lt;/b&gt;:&lt;br&gt;дёргает &lt;i&gt;Serializer&lt;/i&gt; целевого формата и собирает &lt;i&gt;Text&lt;/i&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;MarkedText&lt;/b&gt; — нейтральный обменный формат: разные входные форматы дают одинаковую структуру, поэтому одну входную разметку можно сериализовать в любой выходной формат." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;fontSize=11;spacingLeft=6;spacingTop=4;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="1580" height="200" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
