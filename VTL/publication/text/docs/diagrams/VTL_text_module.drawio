        <mxCell id="p2_parser" value="&lt;b&gt;Parser&lt;/b&gt;&lt;br&gt;&lt;i&gt;&amp;lt;&amp;lt;entry point&amp;gt;&amp;gt;&lt;/i&gt;&lt;hr size=&quot;1&quot;&gt;+ ParseDocumentSequential(Text*, MarkerList*)&lt;br&gt;+ ParseDocumentParallel(Text*, MarkerList*)&lt;br&gt;+ ParseTextSequential(Text*, MarkedText**)&lt;br&gt;+ ParseTextParallel(Text*, MarkedText**)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;align=left;verticalAlign=top;fontSize=12;spacingLeft=6;spacingTop=4;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="460" height="170" as="geometry"/>
        </mxCell>

        <mxCell id="p2_conv" value="&lt;b&gt;Converter&lt;/b&gt;&lt;br&gt;&lt;i&gt;text → MarkedText&lt;/i&gt;&lt;hr size=&quot;1&quot;&gt;+ ConvertToMarkedText(Text*, MarkerList*, MarkedText**)&lt;br&gt;+ SortMarkers(list*)&lt;br&gt;+ MergeMarkers(parts[], MarkerList*)&amp;nbsp; &lt;i&gt;(asciidoc)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=top;fontSize=12;spacingLeft=6;spacingTop=4;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="540" y="620" width="500" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="p2_ser" value="&lt;b&gt;Serializer&lt;/b&gt;&lt;br&gt;&lt;i&gt;MarkedText → text (1 поток)&lt;/i&gt;&lt;hr size=&quot;1&quot;&gt;+ SerializeText(MarkedText*, Text**)&lt;br&gt;+ SerializeFromMarkedText(MarkedText*, Text**)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=top;fontSize=12;spacingLeft=6;spacingTop=4;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="1080" y="620" width="440" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="p2_thr" value="&lt;b&gt;ThreadsShim&lt;/b&gt;&lt;br&gt;&lt;i&gt;_threads.h&amp;nbsp;·&amp;nbsp; _WIN32 / pthread&lt;/i&gt;&lt;hr size=&quot;1&quot;&gt;typedef &amp;lt;format&amp;gt;_thread_t&lt;br&gt;+ thread_create(t*, fn, arg)&lt;br&gt;+ thread_join(t)&lt;br&gt;+ monotonic_seconds()&amp;nbsp; &lt;i&gt;(wall-clock)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=top;fontSize=12;spacingLeft=6;spacingTop=4;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="540" y="800" width="500" height="170" as="geometry"/>
        </mxCell>

        <mxCell id="e2_list_marker" value="1   ◆──   0..* (items)" style="endArrow=diamondThin;endFill=1;endSize=18;startArrow=none;html=1;rounded=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontSize=10;" edge="1" parent="1" source="p2_list" target="p2_marker">
