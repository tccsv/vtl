          <mxGeometry x="740" y="252" width="400" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="p2_scan" value="&lt;b&gt;Scanners&lt;/b&gt;&lt;br&gt;&lt;i&gt;&amp;lt;&amp;lt;thread-fn void*(void*)&amp;gt;&amp;gt;&lt;/i&gt;&lt;hr size=&quot;1&quot;&gt;+ ScanBold(ctx)&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;i&gt;[md / tg / html / ad]&lt;/i&gt;&lt;br&gt;+ ScanItalic(ctx)&amp;nbsp;&amp;nbsp; &lt;i&gt;[md / tg / html / ad]&lt;/i&gt;&lt;br&gt;+ ScanStrike(ctx)&amp;nbsp;&amp;nbsp; &lt;i&gt;[md / tg / html / ad]&lt;/i&gt;&lt;hr size=&quot;1&quot;&gt;&lt;i&gt;asciidoc-only:&lt;/i&gt;&lt;br&gt;+ ScanMono / Sub / Sup&lt;br&gt;+ ScanLink / CrossReference&lt;br&gt;+ ScanHeading / List&lt;br&gt;+ ScanCodeBlock / QuotedBlock&lt;br&gt;+ ScanComment&lt;br&gt;+ ScanAttribute / Admonition" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;align=left;verticalAlign=top;fontSize=12;spacingLeft=6;spacingTop=4;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="740" y="280" width="380" height="270" as="geometry"/>
        </mxCell>

        <mxCell id="p2_pipeline_lbl" value="Пайплайн (_scan.h / _convert.h / процессорный фасад)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=4" vertex="1" parent="1">
          <mxGeometry x="40" y="590" width="600" height="20" as="geometry"/>
